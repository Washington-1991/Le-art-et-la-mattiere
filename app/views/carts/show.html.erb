<%# app/views/carts/show.html.erb %>

<%= render "shared/navbar" %>
<%= render "shared/header" %>
<%= render "shared/flashes" %>

<div class="basket-container mt-4">
  <h2 class="mb-4 text-center">🛒 Votre panier</h2>

  <% if @cart.cart_items.any? %>
    <div class="table-responsive" id="cart_items_table">
      <table class="table table-bordered table-hover align-middle shadow-sm rounded bg-white">
        <thead class="table-light text-center">
          <tr>
            <th>Article</th>
            <th>Prix unitaire</th>
            <th>Quantité</th>
            <th>Total</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody class="text-center">
          <% @cart.cart_items.includes(:article).each do |item| %>
            <tr id="<%= dom_id(item) %>">
              <td class="fw-semibold"><%= item.article.name %></td>
              <td><%= number_to_currency(item.article.price, unit: "€") %></td>
              <td>1</td>
              <td><%= number_to_currency(item.total_price, unit: "€") %></td>
              <td>
                <%= button_to "Supprimer",
                              cart_item_path(item),
                              method: :delete,
                              data: { turbo_confirm: "Êtes-vous sûr de vouloir supprimer #{item.article.name} ?" },
                              class: "btn btn-danger btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="text-end mt-3">
      <h5 id="cart_total">Total: <%= number_to_currency(@cart.total_price, unit: "€") %></h5>
      <div class="mt-3">
        <%= button_to "Vider le panier",
                      clear_cart_items_path,
                      method: :delete,
                      data: { turbo_confirm: "Êtes-vous sûr de vouloir vider le panier ?" },
                      class: "btn btn-warning me-2" %>

        <%= link_to "🧾 Passer au paiement", "#", class: "btn btn-success px-4 py-2" %>
      </div>
    </div>
  <% else %>
    <div class="alert alert-info text-center mt-4" role="alert">
      Votre panier est vide.
    </div>
    <%= link_to "Continuer vos achats", articles_path, class: "btn btn-primary mt-3" %>
  <% end %>
</div>

<%= render "shared/business_cards" %>
